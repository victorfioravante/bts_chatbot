# Porta do servidor backend
PORT=3001

# Dominio do Bitsler
BITSLER_DOMAIN=bitsler.com

# Token de autenticacao (NAO versionar este arquivo)
SOCKET_TOKEN=seu_token_aqui

# Fingerprint do dispositivo (20 chars) - obtido via window.tracer.getFp()
FINGERPRINT=seu_fingerprint_aqui

# Nivel de log: error | warn | info | debug
LOG_LEVEL=info

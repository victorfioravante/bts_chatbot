# ══════════════════════════════════════════════════════════════════
#  Bitsler Chat Bot — Configuração
#
#  COMO PREENCHER:
#  1. Abra o Bitsler no Chrome e faça login
#  2. Opção A (recomendada): gere uma API key em
#       Bitsler → Configurações → API key → Generate
#  3. Opção B: extraia manualmente via DevTools (F12) → Console:
#       copy(window.__vue_store__?.state?.chat?.user?.socketToken)
#       copy(window.tracer.getFp())
# ══════════════════════════════════════════════════════════════════

# ── Login automático ──────────────────────────────────────────────
# OPÇÃO A — API key (recomendada, bypassa 2FA, renova token automaticamente):
#   Gere em: Bitsler → Configurações → API key → Generate
BITSLER_USERNAME=
BITSLER_API_KEY=

# OPÇÃO B — Senha + 2FA automático:
BITSLER_PASSWORD=
# Secret TOTP base32 do app de 2FA:
#   Bitsler → Configurações → 2FA → copie a chave de texto base32
BITSLER_2FA_SECRET=

# Fingerprint do browser (fixo por conta — pegue via DevTools):
#   copy(window.tracer.getFp())
BITSLER_FINGERPRINT=

# ── Tokens manuais (alternativa ao login automático) ──────────────
# Só necessário se NÃO usar BITSLER_API_KEY ou BITSLER_PASSWORD.
# Expira periodicamente — requer extração manual via DevTools:
#   copy(window.__vue_store__?.state?.chat?.user?.socketToken)
SOCKET_TOKEN=

# ── Servidor ──────────────────────────────────────────────────────
# Porta do backend Express (Railway define PORT automaticamente)
PORT=3001

# ── Segurança do painel ───────────────────────────────────────────
# Quando definida, o painel web exige senha antes de exibir dados.
# Deixe em branco para rodar sem autenticação (uso local).
DASHBOARD_PASSWORD=

# ── Logs ──────────────────────────────────────────────────────────
# Nível: error | warn | info | debug
LOG_LEVEL=info

# ── Reconexão ─────────────────────────────────────────────────────
RECONNECT_DELAY_MS=5000
MAX_RECONNECT_ATTEMPTS=10

# ── Modo demo (sem conexão real) ──────────────────────────────────
# true → simula eventos de rain aleatórios para testar a interface
DEMO_MODE=false

# ── Proxy residencial ─────────────────────────────────────────────
# Necessário no Railway para evitar bloqueio por IP de datacenter.
# Formato: http://USUARIO:SENHA@GATEWAY:PORTA
# Deixe em branco para rodar sem proxy (uso local).
PROXY_URL=
